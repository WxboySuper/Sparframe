{
  "name": "@sparframe/contracts",
  "version": "0.1.0",
  "description": "Provider-neutral contracts for Sparframe applications",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",

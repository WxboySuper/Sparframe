{
  "name": "@sparframe/foundation",
  "version": "0.1.0",
  "description": "Shared runtime and composition foundation for Sparframe",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/rewrite-declaration-imports.mjs dist",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/*.test.ts"
  },
  "dependencies": {
    "@sparframe/contracts": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2"
  }
}
